		(exclude_from_sim no)
		(at 110.998 168.402 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
		)
		(uuid "d4aca033-0093-4a6d-aa1b-49881c695d1c")
	)
	(text_box "SCHEMATIC NOTES:\n--I2C -> I2C3_SCL:PIN_PC8; I2C3_SDA:PIN_PC9; \n--Pull-Up for I2C: Rp(min)= (VDD - VOL(max)) / IOL(max)\n--3.3 V (J2 pin 1) not used on main board\n"
		(exclude_from_sim no)
		(at 110.49 166.37 0)
		(size 64.77 29.21)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6fdf379b-0bc3-4486-93a5-f4919a3f56d0")
	)
	(text_box "PIN Mapping (J2 pin  signal: MCU pin)\nPower: 1 = 3.3V (unused on main), 2/4 = +5V (F2)\nGND: 6,9,14,20,25,30,34,39; 49/50 NC (GND on MCU bd)\n3  I2C_SDA: PC9 (function: I2C3)\n5  I2C_SCL: PC8 (function: I2C3)\n7  Force_AIn: PA1 (function: ADC1_IN2)\n8  Hip 1 1: PD10 (function: GPIO input, EXTI10)\n10 Hip 1 2: PD11 (function: GPIO input, EXTI11)\n11 SPARE: PA8 (function: TIM1_CH1 / MCO)\n12 Hip 2 1: PE0 (function: GPIO input, EXTI0)\n13 Hip 2 2: PD2 (function: GPIO input, EXTI2)\n15 Chest_Switch: PB15 (function: GPIO input, EXTI15)\n16 Go_Button: PD8 (function: GPIO input, EXTI8)\n17 SPARE: PC10 (function: GPIO / USART3_TX)\n18 Go_Enable: PB12 (function: GPIO output)\n19 RX_CAN: PD0 (function: FDCAN1_RX)\n21 TX_CAN: PD1 (function: FDCAN1_TX)\n22 Stop_Button: PD9 (function: GPIO input, EXTI9)\n23 CAN Standby: PD3 (function: GPIO output)\n24 PMM_RST: PC11 (function: GPIO output)\n26 Screen_Data_Dir: PD4 (function: USART2_DE)\n27 SPARE: PA2 (function: ADC1_IN3/TIM2_CH3/LPUART1_TX)\n28 Knee 1: PA3 (function: GPIO input, EXTI3)\n29 Knee 2: PD13 (function: GPIO input, EXTI13)\n31 Knee 3: PC7 (function: GPIO input, EXTI7)\n32 Laser_PWM: PB14 (function: TIM15_CH1)\n33 USART_TX: PD5 (function: USART2_TX)\n35 Knee 4: PD12 (function: GPIO input, EXTI12)\n36 Pad 1: PD14 (function: GPIO input, EXTI14)\n37 Stop_Enable: PB13 (function: GPIO output)\n38 Pad 2: PC6 (function: GPIO input, EXTI6)\n40 USART_RX: PD6 (function: USART2_RX)\n41 PGOOD: PE4 (function: GPIO input, EXTI4)\n42 SPARE: PC0 (function: ADC1_IN6)\n43 Pad 3: PC1 (function: GPIO input, EXTI1)\n44 Pad 4: PA5 (function: GPIO input, EXTI5)\n45 SPARE: PB10 (function: USART3_TX)\n46 SPARE: PB11 (function: USART3_RX / ADC1_IN14)\n47 SPARE: PA15 (function: I2C1_SCL)\n48 SPARE: PB7 (function: I2C1_SDA)\nNote: stepper/encoder signals removed 2026-11-24\nNote: switches + PGOOD each have their own EXTI (all 16 used)"
		(exclude_from_sim no)
		(at 58.42 13.97 0)
		(size 63.5 99.3)
		(margins 0.9525 0.9525 0.9525 0.9525)
