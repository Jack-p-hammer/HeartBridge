	)
	(text_box "SCHEMATIC NOTES:\n--I2C -> I2C3_SCL:PIN_PC8; I2C3_SDA:PIN_PC9; \n--Pull-Up for I2C: Rp(min)= (VDD - VOL(max)) / IOL(max)\n--3.3 V (Header 1/17) Disconnected\n"
		(exclude_from_sim no)
		(at 110.49 166.37 0)
		(size 64.77 29.21)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6fdf379b-0bc3-4486-93a5-f4919a3f56d0")
	)
	(text_box "PIN Mapping\nI2C_SDA: PC9 (function: I2C3)\nI2C_SCL: PC8 (function: I2C3)\nForce_AIn: PA1 (function: ADC1_IN2)\nStepper Enable: PD10 (function: GPIO output)\nStepper Sleep: PD11 (function: GPIO output)\nStep: PA8 (function: TIM1_CH1)\nENC1_Z: PE0 (function: TIM4_ETR, encoder index)\nENC2_Z: PD2 (function: TIM3_ETR, encoder index)\nChest_Switch: PB15 (function: GPIO input, EXTI15)\nGo_Button: PD8 (function: GPIO input, EXTI8)\nGo_Enable: PB12 (function: GPIO output)\nTX_CAN: PD1 (function: FDCAN1_TX)\nRX_CAN: PD0 (function: FDCAN1_RX)\nStop_Button: PD9 (function: GPIO input, EXTI9)\nCAN Standby: PD3 (function: GPIO output)\nSTEPPER_nFAULT: PE15 (function: TIM1_BKIN)\nScreen_Data_Dir: PD4 (function: USART2_DE)\nSPARE1: PA2 (function: ADC1_IN3 / TIM2_CH3 / LPUART1_TX)\nSPARE2: PA3 (function: ADC1_IN4 / TIM2_CH4 / LPUART1_RX)\nENC1_B: PD13 (function: TIM4_CH2, encoder)\nENC2_B: PC7 (function: TIM3_CH2, encoder)\nLaser_PWM: PB14 (function: TIM15_CH1)\nUSART_TX: PD5 (function: USART2_TX)\nENC1_A: PD12 (function: TIM4_CH1, encoder)\nDir: PD14 (function: GPIO output)\nStop_Enable: PB13 (function: GPIO output)\nENC2_A: PC6 (function: TIM3_CH1, encoder)\nUSART_RX: PD6 (function: USART2_RX)\nSPARE3: PA0 (function: ADC1_IN1 / TIM2_CH1)\nSPARE4: PC0 (function: ADC1_IN6)\nSPARE5: PC1 (function: ADC1_IN7)\nSPARE6: PA5 (function: DAC1_OUT2 / SPI1_SCK)\nSPARE7: PB10 (function: USART3_TX)\nSPARE8: PB11 (function: USART3_RX / ADC1_IN14)\nSPARE9: PA15 (function: I2C1_SCL)\nSPARE10: PB7 (function: I2C1_SDA)"
		(exclude_from_sim no)
		(at 58.42 15.24 0)
		(size 63.5 85.0899)
		(margins 0.9525 0.9525 0.9525 0.9525)
