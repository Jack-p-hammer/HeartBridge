	(text "Encoder 5 V feed + ESD"
		(exclude_from_sim no)
		(at 16.256 57.15 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "69e39f6d-fdf8-41ba-a0e8-d7694fb3d533")
	)
	(text "Notes\n- This sheet is used twice on the top sheet (Encoder 1, Encoder 2). KiCad numbers the parts 1xx and 2xx.\n- 5 V side: J, D, F, the 1k/100pF/100k filters. Everything after the SN74LVC14 runs on 3.3 V.\n- The Pi reads the LS7366R over SPI1 (mode 0, ~1 MHz). Each LS7366R has its own CS; MISO is shared (tri-state).\n- CS has a pull-up so the counter stays deselected while the Pi boots. LFLAG is open-drain, so it needs one too.\n- Check before ordering the PCB: LS7366R-S package width (footprint here is narrow SOIC-14),\n  and the AMT103 pin order / cable colors."
		(exclude_from_sim no)
		(at 15.748 167.894 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9b84bebc-0c3f-49fa-8624-0b452878d475")
	)
	(text "Encoder + cable + board connector"
		(exclude_from_sim no)
		(at 16.256 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d0b4bf8e-9607-4b37-8aa3-0de8dc842d83")
	)
	(text "5 V -> 3.3 V (Schmitt inverter)"
		(exclude_from_sim no)
		(at 157.48 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e0469fa2-6029-45b9-b518-b05112d9d65f")
	)
	(text "AMT103 on the motor -> CUI-435-1FT cable \n(bare wires) -> Connector on this board. \nPin order comes from the AMT10 datasheet.\n"
