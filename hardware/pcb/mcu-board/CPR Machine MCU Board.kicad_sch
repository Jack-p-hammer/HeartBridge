	(text_box "R2/R3 = 5.1k Rd so C-to-C cables supply power. U2 = ESD, place next to J4.\nVBUS goes to the power supply (diode-OR with +5V_MAIN, to do). USB clock: HSI48 + CRS."
		(exclude_from_sim no)
		(at 17.78 238.76 0)
		(size 60.96 13.97)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width -0.0001)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "119726e1-aee2-4279-b1ca-1c6670e64779")
	)
	(text_box "Notes\n--> VBAT attached to 3.3V (no direct battery connection).\n--> 8 MHz HSE: C13/C14 sized for a crystal with CL = 10 pF: C = 2 x (CL - ~3 pF stray). Recalculate if the crystal bought has a different CL.\n--> Debug STDC14: SWD + SWO + NRST + VCP UART. Pin 13 = target RX (PA10), 14 = target TX (PA9).\\nPins 1, 2, 9, 10, 11 not connected for SWD. Pin 3 = target voltage sense.\n"
		(exclude_from_sim no)
		(at 12.7 252.73 0)
		(size 285.75 30.48)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "32c035f6-1946-4dcd-82bd-fc1e7a8de791")
	)
